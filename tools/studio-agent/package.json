{
  "name": "studio-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Local agent process that drives the in-browser music studio (compile/play/edit) over WebSocket. Iteration 1: Claude via Agent SDK (Max subscription).",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test bench/headless-studio.test.mjs",
    "smoke": "node bench/run.mjs --tasks fm-epiano",
    "test-tasks": "node --test bench/tasks.test.mjs",
    "bench": "node bench/run.mjs",
    "compare": "node bench/compare.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  }
}
